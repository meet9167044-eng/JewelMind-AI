# JewelMind-AI — Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ── MySQL Database ────────────────────────────────────────────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=jewelmind_db
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here

# ── Authentication ────────────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-in-production-generate-with-secrets-token-hex-32

# ── Metal Rate Fetch Service ──────────────────────────────────────────────────
METAL_RATE_API_PROVIDER=GoldAPI
METAL_RATE_API_URL=https://www.goldapi.io/api
METAL_RATE_API_KEY=your_goldapi_key_here
METAL_RATE_REFRESH_INTERVAL=86400

# ── AI Copilot (LLM) ─────────────────────────────────────────────────────────
LLM_API_KEY=your_llm_api_key_here
